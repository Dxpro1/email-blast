{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Private user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Recipient information for email blasts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "History": {
      "title": "Blast History",
      "description": "Record of a sent email blast campaign",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "recipientCount": { "type": "number" },
        "status": { "type": "string", "enum": ["success", "failed", "partial"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "body", "recipientCount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Root user profiles"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": "Contact",
      "description": "User-specific contacts"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "History",
      "description": "User-specific blast campaign history"
    }
  }
}
