rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isSuperAdmin() { return isSignedIn() && request.auth.token.email == 'encorefinancials@gmail.com'; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid is string && data.email is string 
        && data.email.size() <= 256 && data.uid == request.auth.uid;
    }

    function isValidContact(data) {
      return data.keys().hasAll(['email']) && data.email is string && data.email.size() <= 256;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['subject', 'status'])
        && data.subject is string && data.subject.size() <= 500
        && data.status in ['success', 'failed', 'partial', 'in_progress'];
    }

    match /users/{userId} {
      allow read, write: if isSuperAdmin();
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);

      match /contacts/{contactId} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidContact(request.resource.data) && isValidId(contactId);
        allow update: if isOwner(userId) && isValidContact(request.resource.data);
      }

      match /history/{historyId} {
        allow list, get, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidHistory(request.resource.data);
      }
    }
    
    match /test/connection {
      allow get: if isSignedIn();
    }
  }
}
